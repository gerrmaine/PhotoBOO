# Copy this file to `.env` and paste the two values from your Supabase project.
# Dashboard → Project Settings → API:
#   Project URL              → SUPABASE_URL
#   service_role (secret)    → SUPABASE_SERVICE_ROLE_KEY
# Never put the service_role key in the frontend or commit it.

PORT=3000
PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

SUPABASE_URL= 
SUPABASE_SERVICE_ROLE_KEY= 
SUPABASE_BUCKET=photobooth

MAX_UPLOAD_BYTES=8388608
MEMBER_LIMIT=20

# Optional Python image-optimizer sidecar. Leave blank.
IMAGE_SERVICE_URL=
IMAGE_SERVICE_TIMEOUT_MS=1500
